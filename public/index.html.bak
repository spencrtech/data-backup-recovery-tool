<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>MongoDB Backup Manager</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            min-height: 100vh;
            padding: 20px;
        }

        .container {
            max-width: 1200px;
            margin: 0 auto;
        }

        header {
            text-align: center;
            color: white;
            margin-bottom: 40px;
        }

        h1 {
            font-size: 2.5em;
            margin-bottom: 10px;
        }

        .card {
            background: white;
            border-radius: 10px;
            padding: 25px;
            box-shadow: 0 10px 40px rgba(0,0,0,0.1);
            transition: transform 0.2s;
        }

        .card:hover {
            transform: translateY(-5px);
        }

        .card h2 {
            color: #333;
            margin-bottom: 20px;
            font-size: 1.5em;
            border-bottom: 2px solid #667eea;
            padding-bottom: 10px;
        }

        .status-item {
            display: flex;
            justify-content: space-between;
            margin: 10px 0;
            padding: 10px;
            background: #f5f5f5;
            border-radius: 5px;
        }

        .status-label {
            font-weight: 600;
            color: #555;
        }

        .status-value {
            color: #667eea;
            font-weight: 500;
        }

        .button-group {
            display: flex;
            gap: 10px;
            margin: 20px 0;
        }

        button {
            flex: 1;
            padding: 12px 20px;
            border: none;
            border-radius: 5px;
            font-size: 1em;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.2s;
        }

        .btn-primary {
            background: #667eea;
            color: white;
            width: 100%;
        }

        .btn-primary:hover:not(:disabled) {
            background: #5568d3;
        }

        .btn-success {
            background: #48bb78;
            color: white;
        }

        .btn-success:hover:not(:disabled) {
            background: #38a169;
        }

        .btn-danger {
            background: #f56565;
            color: white;
        }

        .btn-danger:hover:not(:disabled) {
            background: #e53e3e;
        }

        button:disabled {
            opacity: 0.5;
            cursor: not-allowed;
        }

        .backups-list {
            list-style: none;
            margin: 15px 0;
            max-height: 150px;
            overflow-y: auto;
        }

        .backup-item {
            background: #f9f9f9;
            border-left: 4px solid #667eea;
            padding: 12px;
            margin: 8px 0;
            border-radius: 3px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            cursor: pointer;
        }

        .backup-item.selected {
            background: #e6e8ff;
            border-left-color: #48bb78;
        }

        .backup-name {
            font-weight: 600;
            color: #333;
        }

        .backup-date {
            font-size: 0.9em;
            color: #999;
        }

        input[type="checkbox"] {
            width: 20px;
            height: 20px;
            cursor: pointer;
        }

        .checkbox-container {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 15px 0;
            padding: 10px;
            background: #fef5e7;
            border-radius: 5px;
            border-left: 4px solid #f39c12;
        }

        .checkbox-container label {
            cursor: pointer;
            font-weight: 500;
            color: #333;
        }

        .message {
            padding: 12px;
            border-radius: 5px;
            margin: 10px 0;
            display: none;
        }

        .message.show {
            display: block;
        }

        .message.success {
            background: #c6f6d5;
            color: #22543d;
            border-left: 4px solid #48bb78;
        }

        .message.error {
            background: #fed7d7;
            color: #742a2a;
            border-left: 4px solid #f56565;
        }

        .message.info {
            background: #bee3f8;
            color: #2c5282;
            border-left: 4px solid #667eea;
        }

        .spinner {
            display: inline-block;
            width: 20px;
            height: 20px;
            border: 3px solid #f3f3f3;
            border-top: 3px solid #667eea;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        @keyframes spin {
            0% { transform: rotate(0deg); }
            100% { transform: rotate(360deg); }
        }

        .config-section {
            background: #f9f9f9;
            padding: 15px;
            border-radius: 5px;
            margin: 15px 0;
        }

        .config-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 12px 0;
            border-bottom: 1px solid #eee;
        }

        .config-item:last-child {
            border-bottom: none;
        }

        .config-label {
            font-weight: 600;
            color: #333;
        }

        .config-value {
            text-align: right;
            color: #667eea;
            font-family: 'Courier New', monospace;
            font-size: 0.95em;
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 12px;
            border-radius: 20px;
            font-size: 0.9em;
            font-weight: 600;
        }

        .status-badge.connected {
            background: #c6f6d5;
            color: #22543d;
        }

        .status-badge.disconnected {
            background: #fed7d7;
            color: #742a2a;
        }

        .status-dot {
            display: inline-block;
            width: 8px;
            height: 8px;
            border-radius: 50%;
            animation: pulse 2s infinite;
        }

        .status-dot.connected {
            background: #48bb78;
        }

        .status-dot.disconnected {
            background: #f56565;
        }

        @keyframes pulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.5; }
        }

        .logs-container {
            background: #1a1a2e;
            color: #e0e0ff;
            padding: 20px;
            border-radius: 5px;
            font-family: 'Courier New', monospace;
            font-size: 1em;
            max-height: 500px;
            overflow-y: auto;
            line-height: 1.8;
            border: 1px solid #2a2a4e;
        }

        .log-line {
            padding: 2px 0;
        }

        .status-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 20px;
            margin-bottom: 0;
        }

        .status-section {
            display: flex;
            flex-direction: column;
        }

        .pagination-container {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 15px 0;
            flex-wrap: wrap;
            gap: 15px;
        }

        .pagination-info {
            font-size: 0.95em;
            color: #666;
            font-weight: 500;
            padding: 8px 12px;
            background: #f0f0f0;
            border-radius: 5px;
            border-left: 3px solid #667eea;
        }

        .pagination-controls {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .pagination-btn {
            padding: 8px 15px;
            border: 1px solid #667eea;
            background: white;
            color: #667eea;
            border-radius: 5px;
            cursor: pointer;
            font-weight: 600;
            transition: all 0.2s;
            min-width: 50px;
        }

        .pagination-btn:hover:not(:disabled) {
            background: #667eea;
            color: white;
        }

        .pagination-btn:disabled {
            opacity: 0.5;
            cursor: not-allowed;
            border-color: #ccc;
            color: #ccc;
        }

        .items-per-page {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .items-per-page select {
            padding: 6px 10px;
            border: 1px solid #ddd;
            border-radius: 5px;
            font-size: 0.95em;
            cursor: pointer;
            background: white;
        }

        .history-table-wrapper {
            overflow-x: auto;
            max-height: 600px;
            overflow-y: auto;
            border: 1px solid #eee;
            border-radius: 5px;
            margin: 15px 0;
        }

        .history-table-wrapper::-webkit-scrollbar {
            width: 8px;
            height: 8px;
        }

        .history-table-wrapper::-webkit-scrollbar-track {
            background: #f1f1f1;
        }

        .history-table-wrapper::-webkit-scrollbar-thumb {
            background: #667eea;
            border-radius: 4px;
        }

        .history-table-wrapper::-webkit-scrollbar-thumb:hover {
            background: #5568d3;
        }

        .history-table {
            width: 100%;
            border-collapse: collapse;
        }

        .history-table thead {
            position: sticky;
            top: 0;
            background: #f9f9f9;
            z-index: 10;
        }

        .history-table thead tr {
            border-bottom: 2px solid #667eea;
        }

        .history-table thead th {
            padding: 12px;
            text-align: left;
            font-weight: 600;
            color: #333;
            background: #f9f9f9;
        }

        .history-table tbody tr {
            border-bottom: 1px solid #eee;
            transition: background 0.2s;
        }

        .history-table tbody tr:hover {
            background: #f9f9f9;
        }

        .history-table tbody td {
            padding: 12px;
            font-size: 0.9em;
        }

        .no-data {
            text-align: center;
            padding: 40px 20px;
            color: #999;
        }

        @media (max-width: 768px) {
            .status-grid {
                grid-template-columns: 1fr;
            }

            h1 {
                font-size: 1.8em;
            }

            .pagination-container {
                flex-direction: column;
                align-items: stretch;
            }

            .pagination-controls {
                justify-content: center;
            }

            .history-table-wrapper {
                max-height: 400px;
            }

            .history-table thead th {
                padding: 8px;
                font-size: 0.85em;
            }

            .history-table tbody td {
                padding: 8px;
                font-size: 0.8em;
            }
        }
    </style>
</head>
<body>
    <div class="container">
        <header>
            <h1>🗄️ MongoDB Backup Manager</h1>
            <p>Manage your production backups and test restores</p>
        </header>

        <!-- Status Card - Full Width -->
        <div class="card" style="margin-bottom: 20px;">
            <h2>Status & Configuration</h2>
            <div class="status-grid">
                <!-- Left Column -->
                <div class="status-section">
                    <h3 style="color: #333; font-size: 1.1em; margin-bottom: 15px;">Database Connections</h3>
                    
                    <div style="margin-bottom: 20px;">
                        <h4 style="color: #333; font-size: 0.95em; margin-bottom: 8px;">Production Database</h4>
                        <div id="prodDbStatus" class="status-badge disconnected">
                            <span class="status-dot disconnected"></span>
                            <span>Checking...</span>
                        </div>
                    </div>
                    <div>
                        <h4 style="color: #333; font-size: 0.95em; margin-bottom: 8px;">Test Database</h4>
                        <div id="testDbStatus" class="status-badge disconnected">
                            <span class="status-dot disconnected"></span>
                            <span>Checking...</span>
                        </div>
                    </div>
                </div>

                <!-- Right Column -->
                <div class="status-section">
                    <h3 style="color: #333; font-size: 1.1em; margin-bottom: 15px;">System Information</h3>
                    
                    <div class="status-item">
                        <span class="status-label">System Status:</span>
                        <span class="status-value" id="systemStatus">Loading...</span>
                    </div>
                    <div class="status-item">
                        <span class="status-label">Last Backup:</span>
                        <span class="status-value" id="lastBackup">Never</span>
                    </div>
                    <div class="status-item">
                        <span class="status-label">Total Backups:</span>
                        <span class="status-value" id="backupCount">0</span>
                    </div>
                </div>
            </div>

            <hr style="margin: 25px 0; border: none; border-top: 1px solid #eee;">

            <h3 style="color: #333; font-size: 1.1em; margin-bottom: 15px;">Scheduled Operations</h3>
            <div class="status-grid">
                <div>
                    <div class="config-item">
                        <span class="config-label">Backup Schedule:</span>
                        <span class="config-value" id="configBackupSchedule">--</span>
                    </div>
                    <div class="config-item">
                        <span class="config-label">Backup Time:</span>
                        <span class="config-value" id="backupTimeDisplay">Disabled</span>
                    </div>
                </div>
                <div>
                    <div class="config-item">
                        <span class="config-label">Restore Schedule:</span>
                        <span class="config-value" id="configRestoreSchedule">--</span>
                    </div>
                    <div class="config-item">
                        <span class="config-label">Restore Time:</span>
                        <span class="config-value" id="restoreTimeDisplay">Disabled</span>
                    </div>
                </div>
            </div>

            <hr style="margin: 25px 0; border: none; border-top: 1px solid #eee;">

            <div class="config-item">
                <span class="config-label">Database Name:</span>
                <span class="config-value" id="configDb">--</span>
            </div>
        </div>

        <!-- Backup and Restore Cards - Side by Side -->
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
            <!-- Backup Card - Left -->
            <div class="card">
                <h2>📦 Backup Production</h2>
                <p style="color: #666; margin-bottom: 20px;">Create a new backup of your production database</p>
                <div class="message" id="backupMessage"></div>
                <button class="btn-primary" id="backupBtn" onclick="performBackup()">
                    📦 Start Backup
                </button>
            </div>

            <!-- Restore Card - Right -->
            <div class="card">
                <h2>↩️ Restore to Test</h2>
                <div class="message" id="restoreMessage"></div>
                
                <h3 style="margin-top: 0; margin-bottom: 10px; color: #333; font-size: 0.95em;">Available Backups</h3>
                <ul class="backups-list" id="backupsList">
                    <li style="color: #999; padding: 10px;">No backups available</li>
                </ul>

                <div class="checkbox-container">
                    <input type="checkbox" id="dropDbCheckbox">
                    <label for="dropDbCheckbox">Drop existing test database before restore</label>
                </div>

                <div class="button-group">
                    <button class="btn-success" id="restoreLatestBtn" onclick="restoreLatest()">
                        ↩️ Restore Latest
                    </button>
                    <button class="btn-danger" id="restoreSelectedBtn" onclick="restoreSelected()" style="display:none;">
                        ↩️ Restore Selected
                    </button>
                </div>
            </div>
        </div>

        <!-- Logs Card - Full Width -->
        <div class="card" style="grid-column: 1 / -1;">
            <h2>Recent Logs</h2>
            <div class="logs-container" id="logsContainer">
                <div class="log-line">Loading logs...</div>
            </div>
            <button class="btn-primary" onclick="refreshLogs()" style="margin-top: 15px;">
                🔄 Refresh Logs
            </button>
        </div>

        <!-- Backup History Card - Full Width -->
        <div class="card" style="grid-column: 1 / -1; margin-top: 20px;">
            <h2>📋 Backup History</h2>

            <!-- Table with Scrolling -->
            <div class="history-table-wrapper">
                <table class="history-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>Type</th>
                            <th>Trigger</th>
                            <th>Status</th>
                            <th>Duration</th>
                            <th>File/Details</th>
                        </tr>
                    </thead>
                    <tbody id="historyTableBody">
                        <tr>
                            <td colspan="6" style="text-align: center; padding: 20px; color: #999;">Loading history...</td>
                        </tr>
                    </tbody>
                </table>
            </div>

            <!-- Pagination Controls - Bottom (All Controls Here) -->
            <div class="pagination-container" style="border-top: 1px solid #eee; padding-top: 15px; margin-top: 15px;">
                <!-- Left: Navigation Buttons -->
                <div class="pagination-controls">
                    <button class="pagination-btn" id="prevBtn" onclick="previousPage()" disabled>← Previous</button>
                    <span id="pageCounter" style="font-weight: 600; color: #667eea; min-width: 100px; text-align: center;">Page 1 of 1</span>
                    <button class="pagination-btn" id="nextBtn" onclick="nextPage()">Next →</button>
                </div>

                <!-- Middle: Dropdowns -->
                <div style="display: flex; gap: 20px; align-items: center;">
                    <div class="items-per-page">
                        <label for="itemsPerPageSelect">Items per page:</label>
                        <select id="itemsPerPageSelect" onchange="changeItemsPerPage()">
                            <option value="10">10</option>
                            <option value="25" selected>25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                    </div>
                    <div class="items-per-page">
                        <label for="recordsLimitSelect">Records to load:</label>
                        <select id="recordsLimitSelect" onchange="changeRecordsLimit()">
                            <option value="50">50</option>
                            <option value="100">100</option>
                            <option value="250">250</option>
                            <option value="500" selected>500</option>
                            <option value="1000">1000</option>
                        </select>
                    </div>
                </div>

                <!-- Right: Record Count Info -->
                <div class="pagination-info">
                    <span id="totalRecords">0 records</span>
                </div>
            </div>

            <button class="btn-primary" onclick="refreshHistory()" style="margin-top: 15px; width: 100%;">
                🔄 Refresh History
            </button>
        </div>
    </div>

    <script>
        const POLL_INTERVAL = 5000;
        let selectedBackup = null;
        let isOperationRunning = false;
        
        // Pagination state
        let paginationState = {
            currentPage: 1,
            itemsPerPage: 25,
            recordsLimit: 500,
            totalRecords: 0,
            allHistory: [],
            totalPages: 1
        };

        async function loadStatus() {
            try {
                const response = await fetch('/api/status');
                const data = await response.json();

                document.getElementById('systemStatus').textContent = data.isRunning ? '🟡 Running' : '🟢 Ready';
                document.getElementById('backupCount').textContent = data.backups.length;
                document.getElementById('lastBackup').textContent = data.lastBackup 
                    ? new Date(data.lastBackup).toLocaleString() 
                    : 'Never';
                document.getElementById('configDb').textContent = data.config.dbName;
                document.getElementById('configBackupSchedule').textContent = data.config.backupSchedule || 'Disabled';
                document.getElementById('configRestoreSchedule').textContent = data.config.restoreSchedule || 'Disabled';

                // Parse and display schedule times
                displayScheduleTime('configBackupSchedule', 'backupTimeDisplay', data.config.backupSchedule);
                displayScheduleTime('configRestoreSchedule', 'restoreTimeDisplay', data.config.restoreSchedule);

                // Check database connections
                checkDatabaseConnections(data);

                renderBackups(data.backups);
            } catch (err) {
                console.error('Error loading status:', err);
            }
        }

        function changeItemsPerPage() {
            const select = document.getElementById('itemsPerPageSelect');
            paginationState.itemsPerPage = parseInt(select.value);
            paginationState.currentPage = 1;
            renderHistoryPage();
        }

        function changeRecordsLimit() {
            const select = document.getElementById('recordsLimitSelect');
            paginationState.recordsLimit = parseInt(select.value);
            paginationState.currentPage = 1;
            refreshHistory();
        }

        function previousPage() {
            if (paginationState.currentPage > 1) {
                paginationState.currentPage--;
                renderHistoryPage();
            }
        }

        function nextPage() {
            if (paginationState.currentPage < paginationState.totalPages) {
                paginationState.currentPage++;
                renderHistoryPage();
            }
        }

        function renderHistoryPage() {
            const start = (paginationState.currentPage - 1) * paginationState.itemsPerPage;
            const end = start + paginationState.itemsPerPage;
            const pageData = paginationState.allHistory.slice(start, end);
            
            const tbody = document.getElementById('historyTableBody');

            if (!pageData || pageData.length === 0) {
                if (paginationState.allHistory.length === 0) {
                    tbody.innerHTML = '<tr><td colspan="6" class="no-data">No backup history found</td></tr>';
                } else {
                    tbody.innerHTML = '<tr><td colspan="6" class="no-data">No records on this page</td></tr>';
                }
            } else {
                tbody.innerHTML = pageData.map(entry => {
                    const timestamp = new Date(entry.timestamp).toLocaleString();
                    const type = entry.type === 'backup' ? '📦 Backup' : '↩️ Restore';
                    const trigger = entry.trigger === 'manual' ? '👤 Manual' : '⏰ Scheduled';
                    const statusColor = entry.status === 'success' ? '#48bb78' : '#f56565';
                    const statusIcon = entry.status === 'success' ? '✓' : '✗';
                    const status = `<span style="color: ${statusColor}; font-weight: 600;">${statusIcon} ${entry.status}</span>`;
                    const duration = entry.duration ? `${entry.duration}s` : '-';
                    
                    let details = '-';
                    if (entry.status === 'success' && entry.fileName) {
                        const size = entry.fileSize ? ` (${formatBytes(entry.fileSize)})` : '';
                        details = `<code style="background: #f0f0f0; padding: 4px 8px; border-radius: 3px; font-size: 0.85em;">${entry.fileName}${size}</code><br><small style="color: #999;">${entry.filePath}</small>`;
                    } else if (entry.status === 'success' && entry.sourceFile) {
                        details = `<code style="background: #f0f0f0; padding: 4px 8px; border-radius: 3px; font-size: 0.85em;">${entry.sourceFile}</code>`;
                    } else if (entry.error) {
                        details = `<small style="color: #f56565;">${entry.error}</small>`;
                    }

                    return `
                        <tr>
                            <td>${timestamp}</td>
                            <td>${type}</td>
                            <td>${trigger}</td>
                            <td>${status}</td>
                            <td>${duration}</td>
                            <td style="font-size: 0.9em;">${details}</td>
                        </tr>
                    `;
                }).join('');
            }

            // Update pagination controls
            updatePaginationControls();
        }

        function updatePaginationControls() {
            const prevBtn = document.getElementById('prevBtn');
            const nextBtn = document.getElementById('nextBtn');
            const pageCounter = document.getElementById('pageCounter');
            const totalRecords = document.getElementById('totalRecords');

            // Disable buttons appropriately
            prevBtn.disabled = paginationState.currentPage <= 1;
            nextBtn.disabled = paginationState.currentPage >= paginationState.totalPages || paginationState.totalPages <= 1;
            
            // Update page counter
            pageCounter.textContent = `Page ${paginationState.currentPage} of ${paginationState.totalPages}`;
            
            // Update record count
            if (paginationState.totalRecords === 0) {
                totalRecords.textContent = '0 records';
            } else {
                const startRecord = (paginationState.currentPage - 1) * paginationState.itemsPerPage + 1;
                const endRecord = Math.min(paginationState.currentPage * paginationState.itemsPerPage, paginationState.totalRecords);
                totalRecords.textContent = `Showing ${startRecord}-${endRecord} of ${paginationState.totalRecords}`;
            }
        }

        function displayScheduleTime(cronElementId, displayElementId, cronExpression) {
            const displayEl = document.getElementById(displayElementId);
            if (!cronExpression) {
                displayEl.textContent = 'Disabled';
                return;
            }

            const parts = cronExpression.split(' ');
            if (parts.length < 5) {
                displayEl.textContent = 'Invalid schedule';
                return;
            }

            const minute = parts[0];
            const hour = parts[1];
            const dayOfMonth = parts[2];
            const month = parts[3];
            const dayOfWeek = parts[4];

            let timeStr = '';

            // Handle hour and minute
            if (hour !== '*' && minute !== '*') {
                const hourNum = parseInt(hour);
                const minNum = parseInt(minute);
                const ampm = hourNum >= 12 ? 'PM' : 'AM';
                const displayHour = hourNum % 12 || 12;
                timeStr = `${String(displayHour).padStart(2, '0')}:${String(minNum).padStart(2, '0')} ${ampm}`;
            }

            // Handle frequency
            let frequency = '';
            if (dayOfMonth !== '*' && month !== '*') {
                frequency = `on day ${dayOfMonth}`;
            } else if (dayOfWeek !== '*' && dayOfWeek !== '0-4') {
                const days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
                if (dayOfWeek >= 0 && dayOfWeek < 7) {
                    frequency = `every ${days[dayOfWeek]}`;
                } else {
                    frequency = 'custom schedule';
                }
            } else if (dayOfMonth === '*' && month === '*' && dayOfWeek === '*') {
                frequency = 'every day';
            }

            displayEl.textContent = timeStr && frequency ? `${timeStr} (${frequency})` : (timeStr || 'Custom schedule');
        }

        function checkDatabaseConnections(data) {
            updateDbStatus('prodDbStatus', data.connections.production);
            updateDbStatus('testDbStatus', data.connections.test);
        }

        function updateDbStatus(elementId, isConnected) {
            const element = document.getElementById(elementId);
            if (isConnected) {
                element.className = 'status-badge connected';
                element.innerHTML = '<span class="status-dot connected"></span><span>✓ Connected</span>';
            } else {
                element.className = 'status-badge disconnected';
                element.innerHTML = '<span class="status-dot disconnected"></span><span>✗ Disconnected</span>';
            }
        }

        function renderBackups(backups) {
            const list = document.getElementById('backupsList');
            const restoreBtn = document.getElementById('restoreSelectedBtn');

            if (backups.length === 0) {
                list.innerHTML = '<li style="color: #999; padding: 10px;">No backups available</li>';
                restoreBtn.style.display = 'none';
                return;
            }

            list.innerHTML = backups.map(backup => `
                <li class="backup-item" onclick="selectBackup('${backup.path}', this)">
                    <div>
                        <div class="backup-name">${backup.name}</div>
                        <div class="backup-date">Created: ${backup.created || 'Unknown'}</div>
                    </div>
                </li>
            `).join('');

            restoreBtn.style.display = selectedBackup ? 'block' : 'none';
        }

        function selectBackup(path, element) {
            document.querySelectorAll('.backup-item').forEach(el => el.classList.remove('selected'));
            element.classList.add('selected');
            selectedBackup = path;
        }

        async function performBackup() {
            if (isOperationRunning) return;
            
            const btn = document.getElementById('backupBtn');
            const msg = document.getElementById('backupMessage');
            
            showMessage(msg, '⏳ Starting backup...', 'info');
            btn.disabled = true;
            isOperationRunning = true;

            try {
                const response = await fetch('/api/backup', { method: 'POST' });
                const data = await response.json();

                if (response.ok) {
                    showMessage(msg, '✅ Backup completed successfully!', 'success');
                    setTimeout(loadStatus, 1000);
                } else {
                    showMessage(msg, '❌ ' + data.error, 'error');
                }
            } catch (err) {
                showMessage(msg, '❌ ' + err.message, 'error');
            } finally {
                btn.disabled = false;
                isOperationRunning = false;
            }
        }

        async function restoreLatest() {
            if (isOperationRunning) return;
            
            const msg = document.getElementById('restoreMessage');
            const dropDb = document.getElementById('dropDbCheckbox').checked;

            showMessage(msg, '⏳ Starting restore...', 'info');
            isOperationRunning = true;

            try {
                const response = await fetch('/api/restore-latest', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ dropDb })
                });
                const data = await response.json();

                if (response.ok) {
                    showMessage(msg, '✅ Restore completed successfully!', 'success');
                } else {
                    showMessage(msg, '❌ ' + data.error, 'error');
                }
            } catch (err) {
                showMessage(msg, '❌ ' + err.message, 'error');
            } finally {
                isOperationRunning = false;
            }
        }

        async function restoreSelected() {
            if (!selectedBackup || isOperationRunning) return;
            
            const msg = document.getElementById('restoreMessage');
            const dropDb = document.getElementById('dropDbCheckbox').checked;

            showMessage(msg, '⏳ Starting restore...', 'info');
            isOperationRunning = true;

            try {
                const response = await fetch('/api/restore', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ backupFile: selectedBackup, dropDb })
                });
                const data = await response.json();

                if (response.ok) {
                    showMessage(msg, '✅ Restore completed successfully!', 'success');
                } else {
                    showMessage(msg, '❌ ' + data.error, 'error');
                }
            } catch (err) {
                showMessage(msg, '❌ ' + err.message, 'error');
            } finally {
                isOperationRunning = false;
            }
        }

        async function refreshLogs() {
            try {
                const response = await fetch('/api/logs');
                const data = await response.json();
                const logsContainer = document.getElementById('logsContainer');
                logsContainer.innerHTML = data.logs
                    .map(line => `<div class="log-line">${escapeHtml(line)}</div>`)
                    .join('');
                logsContainer.scrollTop = logsContainer.scrollHeight;
            } catch (err) {
                console.error('Error loading logs:', err);
            }
        }

        function showMessage(element, text, type) {
            element.textContent = text;
            element.className = `message show ${type}`;
            if (type !== 'error') {
                setTimeout(() => {
                    element.classList.remove('show');
                }, 5000);
            }
        }

        function escapeHtml(text) {
            const map = {
                '&': '&amp;',
                '<': '&lt;',
                '>': '&gt;',
                '"': '&quot;',
                "'": '&#039;'
            };
            return text.replace(/[&<>"']/g, m => map[m]);
        }

        async function refreshHistory() {
            try {
                const response = await fetch(`/api/backup-history?limit=${paginationState.recordsLimit}`);
                const data = await response.json();

                // Store all history for pagination
                paginationState.allHistory = data.history || [];
                paginationState.totalRecords = paginationState.allHistory.length;
                paginationState.totalPages = paginationState.totalRecords > 0 
                    ? Math.ceil(paginationState.totalRecords / paginationState.itemsPerPage) 
                    : 1;
                paginationState.currentPage = 1;

                renderHistoryPage();
            } catch (err) {
                console.error('Error loading history:', err);
                document.getElementById('historyTableBody').innerHTML = '<tr><td colspan="6" style="text-align: center; padding: 20px; color: #f56565;">Error loading history</td></tr>';
                paginationState.totalRecords = 0;
                paginationState.totalPages = 1;
                paginationState.currentPage = 1;
                updatePaginationControls();
            }
        }

        function formatBytes(bytes) {
            if (bytes === 0) return '0 Bytes';
            const k = 1024;
            const sizes = ['Bytes', 'KB', 'MB', 'GB'];
            const i = Math.floor(Math.log(bytes) / Math.log(k));
            return Math.round((bytes / Math.pow(k, i)) * 100) / 100 + ' ' + sizes[i];
        }

        // Initialize
        loadStatus();
        refreshLogs();
        refreshHistory();
        setInterval(loadStatus, POLL_INTERVAL);
        setInterval(refreshLogs, POLL_INTERVAL * 2);
        setInterval(refreshHistory, POLL_INTERVAL * 3);
    </script>
</body>
</html>